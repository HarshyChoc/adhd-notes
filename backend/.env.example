SYNC_PROVIDER=mock
BIND_HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgresql://your-user@127.0.0.1:5432/md_sticky_notes
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/auth/google/callback
APP_DESKTOP_REDIRECT_URI=mdstickynotes://auth/callback
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
SESSION_TTL_DAYS=30
GOOGLE_SYNC_INTERVAL_MS=15000
MOCK_USER_EMAIL=local-dev@mdstickynotes.dev
ALLOWED_GOOGLE_EMAILS=you@example.com
INTERNAL_CRON_AUDIENCE=https://api.mdstickynotes.com/internal/cron/sync
INTERNAL_CRON_SERVICE_ACCOUNT_EMAIL=cloud-scheduler@your-project.iam.gserviceaccount.com
